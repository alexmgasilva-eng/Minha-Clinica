{
  "name": "BankAccount",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "title": "Organiza\u00e7\u00e3o"
    },
    "bank_name": {
      "type": "string",
      "title": "Banco"
    },
    "account_type": {
      "type": "string",
      "enum": [
        "corrente",
        "poupanca",
        "pagamento",
        "investimento"
      ],
      "title": "Tipo de Conta"
    },
    "agency": {
      "type": "string",
      "title": "Ag\u00eancia"
    },
    "masked_account_number": {
      "type": "string",
      "title": "Conta (mascarada)"
    },
    "holder_name": {
      "type": "string",
      "title": "Titular"
    },
    "holder_document": {
      "type": "string",
      "title": "CPF/CNPJ do Titular"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active",
      "title": "Status"
    },
    "integration_status": {
      "type": "string",
      "enum": [
        "not_connected",
        "pending",
        "connected",
        "error"
      ],
      "default": "not_connected",
      "title": "Status de Integra\u00e7\u00e3o"
    }
  },
  "required": [
    "organization_id",
    "bank_name",
    "holder_name"
  ]
}