{
  "name": "FinancialResponsible",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "title": "Organiza\u00e7\u00e3o"
    },
    "patient_id": {
      "type": "string",
      "title": "Paciente"
    },
    "full_name": {
      "type": "string",
      "title": "Nome Completo"
    },
    "cpf": {
      "type": "string",
      "title": "CPF"
    },
    "phone": {
      "type": "string",
      "title": "Telefone"
    },
    "email": {
      "type": "string",
      "title": "E-mail"
    },
    "relationship_to_patient": {
      "type": "string",
      "title": "Rela\u00e7\u00e3o com o Paciente"
    },
    "address": {
      "type": "string",
      "title": "Endere\u00e7o"
    },
    "receives_receipts": {
      "type": "boolean",
      "default": true,
      "title": "Recebe Recibos"
    },
    "receives_payment_reminders": {
      "type": "boolean",
      "default": true,
      "title": "Recebe Lembretes"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active",
      "title": "Status"
    }
  },
  "required": [
    "organization_id",
    "patient_id",
    "full_name"
  ]
}