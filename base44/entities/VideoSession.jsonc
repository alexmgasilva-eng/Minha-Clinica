{
  "name": "VideoSession",
  "type": "object",
  "properties": {
    "patient_id": {
      "type": "string",
      "title": "Paciente ID"
    },
    "patient_name": {
      "type": "string",
      "title": "Nome do Paciente"
    },
    "appointment_id": {
      "type": "string",
      "title": "Consulta ID"
    },
    "platform": {
      "type": "string",
      "enum": [
        "google_meet",
        "zoom",
        "microsoft_teams",
        "whatsapp"
      ],
      "title": "Plataforma"
    },
    "meeting_url": {
      "type": "string",
      "title": "Link da Reuni\u00e3o"
    },
    "meeting_id": {
      "type": "string",
      "title": "ID da Reuni\u00e3o"
    },
    "password": {
      "type": "string",
      "title": "Senha"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Data"
    },
    "time": {
      "type": "string",
      "title": "Hor\u00e1rio"
    },
    "duration_minutes": {
      "type": "number",
      "default": 50,
      "title": "Dura\u00e7\u00e3o (min)"
    },
    "status": {
      "type": "string",
      "enum": [
        "agendada",
        "em_andamento",
        "finalizada",
        "cancelada"
      ],
      "default": "agendada",
      "title": "Status"
    },
    "notes": {
      "type": "string",
      "title": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "patient_name",
    "platform",
    "date",
    "time"
  ]
}