{
  "name": "FinancialEntry",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "title": "Organiza\u00e7\u00e3o"
    },
    "type": {
      "type": "string",
      "enum": [
        "receita",
        "despesa"
      ],
      "title": "Tipo"
    },
    "source": {
      "type": "string",
      "title": "Origem"
    },
    "category": {
      "type": "string",
      "title": "Categoria"
    },
    "accounting_category": {
      "type": "string",
      "title": "Categoria Cont\u00e1bil"
    },
    "fiscal_category": {
      "type": "string",
      "title": "Categoria Fiscal"
    },
    "description": {
      "type": "string",
      "title": "Descri\u00e7\u00e3o"
    },
    "amount": {
      "type": "number",
      "title": "Valor"
    },
    "value": {
      "type": "number",
      "title": "Valor (legado)"
    },
    "competence_date": {
      "type": "string",
      "format": "date",
      "title": "Data de Compet\u00eancia"
    },
    "cash_date": {
      "type": "string",
      "format": "date",
      "title": "Data de Caixa"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "title": "Vencimento"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Data (legado)"
    },
    "paid_at": {
      "type": "string",
      "format": "date",
      "title": "Pago em"
    },
    "patient_id": {
      "type": "string",
      "title": "Paciente"
    },
    "patient_name": {
      "type": "string",
      "title": "Nome do Paciente"
    },
    "appointment_id": {
      "type": "string",
      "title": "Consulta"
    },
    "supplier_name": {
      "type": "string",
      "title": "Fornecedor"
    },
    "supplier_document": {
      "type": "string",
      "title": "CPF/CNPJ Fornecedor"
    },
    "payment_method": {
      "type": "string",
      "title": "Forma de Pagamento"
    },
    "bank_account_id": {
      "type": "string",
      "title": "Conta Banc\u00e1ria"
    },
    "document_file": {
      "type": "string",
      "title": "Documento"
    },
    "deductibility_suggested": {
      "type": "boolean",
      "title": "Dedut\u00edvel (sugerido)"
    },
    "deductibility_reviewed": {
      "type": "boolean",
      "title": "Dedutibilidade Revisada"
    },
    "deductibility_status": {
      "type": "string",
      "enum": [
        "pending",
        "deductible",
        "non_deductible",
        "partial"
      ],
      "default": "pending",
      "title": "Status de Dedutibilidade"
    },
    "accounting_review_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "adjustment_requested"
      ],
      "default": "pending",
      "title": "Status de Revis\u00e3o Cont\u00e1bil"
    },
    "created_by": {
      "type": "string",
      "title": "Criado por"
    },
    "reviewed_by": {
      "type": "string",
      "title": "Revisado por"
    }
  },
  "required": [
    "type",
    "amount"
  ]
}