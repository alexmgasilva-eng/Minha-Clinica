{
  "name": "Payment",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "title": "Organiza\u00e7\u00e3o"
    },
    "appointment_id": {
      "type": "string",
      "title": "Consulta"
    },
    "patient_id": {
      "type": "string",
      "title": "Paciente"
    },
    "patient_name": {
      "type": "string",
      "title": "Nome do Paciente"
    },
    "financial_responsible_id": {
      "type": "string",
      "title": "Respons\u00e1vel Financeiro"
    },
    "amount": {
      "type": "number",
      "title": "Valor"
    },
    "value": {
      "type": "number",
      "title": "Valor (legado)"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "title": "Data de Vencimento"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Data (legado)"
    },
    "paid_at": {
      "type": "string",
      "format": "date",
      "title": "Pago em"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "pix",
        "dinheiro",
        "cartao",
        "transferencia",
        "boleto"
      ],
      "title": "Forma de Pagamento"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "overdue",
        "partially_paid",
        "cancelled",
        "refunded",
        "pago",
        "pendente",
        "atrasado"
      ],
      "default": "pending",
      "title": "Status"
    },
    "bank_account_id": {
      "type": "string",
      "title": "Conta Banc\u00e1ria"
    },
    "proof_file": {
      "type": "string",
      "title": "Comprovante"
    },
    "reconciliation_status": {
      "type": "string",
      "enum": [
        "pending",
        "reconciled",
        "divergent"
      ],
      "default": "pending",
      "title": "Status de Concilia\u00e7\u00e3o"
    },
    "notes": {
      "type": "string",
      "title": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "patient_id",
    "amount"
  ]
}