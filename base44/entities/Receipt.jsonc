{
  "name": "Receipt",
  "type": "object",
  "properties": {
    "patient_id": {
      "type": "string",
      "title": "Paciente ID"
    },
    "patient_name": {
      "type": "string",
      "title": "Nome do Paciente"
    },
    "value": {
      "type": "number",
      "title": "Valor"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Data"
    },
    "description": {
      "type": "string",
      "title": "Descri\u00e7\u00e3o"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "emitido"
      ],
      "default": "pendente",
      "title": "Status"
    },
    "receipt_number": {
      "type": "string",
      "title": "N\u00famero do Recibo"
    }
  },
  "required": [
    "patient_id",
    "value",
    "date"
  ]
}