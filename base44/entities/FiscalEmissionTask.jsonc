{
  "name": "FiscalEmissionTask",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "title": "Organiza\u00e7\u00e3o"
    },
    "fiscal_receipt_id": {
      "type": "string",
      "title": "Recibo Fiscal"
    },
    "responsible_user_id": {
      "type": "string",
      "title": "Respons\u00e1vel"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "completed",
        "cancelled",
        "error"
      ],
      "default": "pending",
      "title": "Status"
    },
    "missing_fields": {
      "type": "string",
      "title": "Campos Faltantes (JSON)"
    },
    "validation_errors": {
      "type": "string",
      "title": "Erros de Valida\u00e7\u00e3o (JSON)"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium",
      "title": "Prioridade"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "title": "Prazo"
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "title": "Iniciado em"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "title": "Conclu\u00eddo em"
    },
    "notes": {
      "type": "string",
      "title": "Notas"
    },
    "current_step": {
      "type": "number",
      "default": 0,
      "title": "Etapa Atual"
    }
  },
  "required": [
    "organization_id",
    "fiscal_receipt_id"
  ]
}