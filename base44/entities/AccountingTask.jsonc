{
  "name": "AccountingTask",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "title": "Organiza\u00e7\u00e3o"
    },
    "accounting_period_id": {
      "type": "string",
      "title": "Compet\u00eancia"
    },
    "assigned_user_id": {
      "type": "string",
      "title": "Atribu\u00eddo a"
    },
    "created_by": {
      "type": "string",
      "title": "Criado por"
    },
    "task_type": {
      "type": "string",
      "enum": [
        "send_document",
        "review_expense",
        "validate_receipt",
        "close_period",
        "other"
      ],
      "title": "Tipo"
    },
    "title": {
      "type": "string",
      "title": "T\u00edtulo"
    },
    "description": {
      "type": "string",
      "title": "Descri\u00e7\u00e3o"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium",
      "title": "Prioridade"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "title": "Prazo"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "completed",
        "cancelled"
      ],
      "default": "pending",
      "title": "Status"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "title": "Conclu\u00eddo em"
    },
    "client_visible": {
      "type": "boolean",
      "default": true,
      "title": "Vis\u00edvel ao Cliente"
    },
    "related_entity": {
      "type": "string",
      "title": "Entidade Relacionada"
    },
    "related_record_id": {
      "type": "string",
      "title": "ID do Registro"
    }
  },
  "required": [
    "organization_id",
    "title"
  ]
}