{
  "name": "Appointment",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "title": "Organiza\u00e7\u00e3o"
    },
    "professional_id": {
      "type": "string",
      "title": "Profissional"
    },
    "patient_id": {
      "type": "string",
      "title": "Paciente"
    },
    "financial_responsible_id": {
      "type": "string",
      "title": "Respons\u00e1vel Financeiro"
    },
    "patient_name": {
      "type": "string",
      "title": "Nome do Paciente"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Data"
    },
    "time": {
      "type": "string",
      "title": "Hor\u00e1rio"
    },
    "end_time": {
      "type": "string",
      "title": "Hor\u00e1rio Final"
    },
    "start_datetime": {
      "type": "string",
      "format": "date-time",
      "title": "In\u00edcio"
    },
    "end_datetime": {
      "type": "string",
      "format": "date-time",
      "title": "Fim"
    },
    "type": {
      "type": "string",
      "enum": [
        "presencial",
        "online"
      ],
      "default": "presencial",
      "title": "Tipo"
    },
    "service_type": {
      "type": "string",
      "enum": [
        "presencial",
        "online"
      ],
      "default": "presencial",
      "title": "Modalidade"
    },
    "video_platform": {
      "type": "string",
      "enum": [
        "google_meet",
        "zoom",
        "microsoft_teams",
        "whatsapp",
        ""
      ],
      "title": "Plataforma de V\u00eddeo"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "scheduled",
        "awaiting_confirmation",
        "confirmed",
        "completed",
        "cancelled",
        "no_show",
        "agendada",
        "confirmada",
        "realizada",
        "cancelada",
        "falta"
      ],
      "default": "scheduled",
      "title": "Status"
    },
    "session_value": {
      "type": "number",
      "title": "Valor da Sess\u00e3o"
    },
    "value": {
      "type": "number",
      "title": "Valor (legado)"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "overdue",
        "waived"
      ],
      "default": "pending",
      "title": "Status do Pagamento"
    },
    "fiscal_status": {
      "type": "string",
      "enum": [
        "not_applicable",
        "pending_receipt",
        "receipt_issued",
        "exempt"
      ],
      "default": "pending_receipt",
      "title": "Status Fiscal"
    },
    "location": {
      "type": "string",
      "title": "Local"
    },
    "external_calendar_event_id": {
      "type": "string",
      "title": "ID no Google Calendar"
    },
    "video_session_id": {
      "type": "string",
      "title": "Sess\u00e3o de V\u00eddeo"
    },
    "cancellation_reason": {
      "type": "string",
      "title": "Motivo do Cancelamento"
    },
    "notes_administrative": {
      "type": "string",
      "title": "Observa\u00e7\u00f5es Administrativas"
    },
    "notes": {
      "type": "string",
      "title": "Observa\u00e7\u00f5es (legado)"
    },
    "meet_link": {
      "type": "string",
      "title": "Link de V\u00eddeo"
    },
    "created_by": {
      "type": "string",
      "title": "Criado por"
    },
    "updated_by": {
      "type": "string",
      "title": "Atualizado por"
    }
  },
  "required": [
    "patient_name",
    "date",
    "time"
  ]
}