{
  "name": "AuditEvent",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "title": "Organiza\u00e7\u00e3o"
    },
    "user_id": {
      "type": "string",
      "title": "Usu\u00e1rio"
    },
    "user_role": {
      "type": "string",
      "title": "Papel do Usu\u00e1rio"
    },
    "action": {
      "type": "string",
      "enum": [
        "create",
        "update",
        "delete",
        "approve",
        "cancel",
        "status_change",
        "accounting_review",
        "receipt_issue",
        "upload",
        "permission_change",
        "connect",
        "revoke"
      ],
      "title": "A\u00e7\u00e3o"
    },
    "entity_name": {
      "type": "string",
      "title": "Entidade"
    },
    "record_id": {
      "type": "string",
      "title": "ID do Registro"
    },
    "previous_data": {
      "type": "string",
      "title": "Dado Anterior (JSON)"
    },
    "new_data": {
      "type": "string",
      "title": "Dado Novo (JSON)"
    },
    "reason": {
      "type": "string",
      "title": "Motivo"
    },
    "source": {
      "type": "string",
      "enum": [
        "web",
        "api",
        "system",
        "webhook"
      ],
      "default": "web",
      "title": "Origem"
    },
    "ip_address": {
      "type": "string",
      "title": "IP"
    }
  },
  "required": [
    "organization_id",
    "action",
    "entity_name"
  ]
}